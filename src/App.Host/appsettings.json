{
  "Logging": {
    "MinimumLevel": "Information",
    "MainLogPath": "logs/logistics-hmi-.log",
    "CommLogPath": "logs/comm-.log",
    "MainLogRetentionDays": 30,
    "CommLogRetentionDays": 14
  },

  "Window": {
    "Title": "Logistics HMI — 物流上位机系统",
    "Width": 1280,
    "Height": 800,
    "MinWidth": 1024,
    "MinHeight": 600,
    "StartMaximized": true,
    "MinimizeToTrayOnClose": true
  },

  "Theme": {
    "DefaultTheme": "工业蓝",
    "AllowThemeSwitch": true
  },

  "Communication": {
    "DefaultTimeoutMs": 5000,
    "HeartbeatIntervalMs": 30000,
    "AutoReconnect": true,
    "ReconnectMaxRetries": 5,
    "ReconnectBaseDelayMs": 1000
  },

  "DeviceScan": {
    "Enabled": true,
    "IntervalMs": 500,
    "CacheTtlMs": 200
  },

  "ConnectionPool": {
    "MaxConcurrentConnections": 10,
    "HealthCheckIntervalMs": 30000,
    "AutoStartHealthCheck": true,
    "HealthCheckTimeoutMs": 5000
  },

  "Devices": [
    {
      "DeviceId": "modbus-plc-1",
      "DriverType": "ModbusTCP",
      "DisplayName": "1号PLC",
      "TimeoutMs": 5000,
      "Host": "192.168.1.100",
      "Port": 502,
      "SlaveAddress": 1
    },
    {
      "DeviceId": "mqtt-broker-1",
      "DriverType": "MQTT",
      "DisplayName": "MQTT 消息代理",
      "Broker": "127.0.0.1",
      "Port": 1883,
      "Qos": 1
    },
    {
      "DeviceId": "opcua-server-1",
      "DriverType": "OPCUA",
      "DisplayName": "OPC UA 服务器",
      "ServerUrl": "opc.tcp://127.0.0.1:4840"
    },
    {
      "DeviceId": "s7-plc-1",
      "DriverType": "S7",
      "DisplayName": "1号西门子PLC (S7-1200)",
      "IpAddress": "192.168.0.1",
      "CpuType": "S71200",
      "Rack": 0,
      "Slot": 1,
      "TimeoutMs": 5000
    },
    {
      "DeviceId": "modbus-rtu-1",
      "DriverType": "ModbusRTU",
      "DisplayName": "输送线1号RTU",
      "ComPort": "COM3",
      "BaudRate": 19200,
      "DataBits": 8,
      "Parity": "Even",
      "StopBits": "One",
      "SlaveAddress": 1
    }
  ]
}
