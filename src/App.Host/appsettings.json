{
  "Logging": {
    "MinimumLevel": "Information",
    "MainLogPath": "logs/logistics-hmi-.log",
    "CommLogPath": "logs/comm-.log",
    "MainLogRetentionDays": 30,
    "CommLogRetentionDays": 14
  },

  "Window": {
    "Title": "Logistics HMI — 物流上位机系统",
    "Width": 1280,
    "Height": 800,
    "MinWidth": 1024,
    "MinHeight": 600,
    "StartMaximized": true,
    "MinimizeToTrayOnClose": true
  },

  "Theme": {
    "DefaultTheme": "工业蓝",
    "AllowThemeSwitch": true
  },

  "Communication": {
    "DefaultTimeoutMs": 5000,
    "HeartbeatIntervalMs": 30000,
    "AutoReconnect": true,
    "ReconnectMaxRetries": 5,
    "ReconnectBaseDelayMs": 1000
  },

  "DeviceScan": {
    "Enabled": true,
    "IntervalMs": 500,
    "CacheTtlMs": 200
  }
}
