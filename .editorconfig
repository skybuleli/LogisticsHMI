# EditorConfig — LogisticsHMI 代码风格统一
# 顶层文件

root = true

# 所有文件
[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

# C# 文件
[*.cs]
indent_style = space
indent_size = 4
csharp_new_line_before_open_brace = all
csharp_indent_labels = one_less_than_current
csharp_using_directive_placement = outside_namespace

# XML / XAML 文件
[*.{xml,axaml,xaml}]
indent_style = space
indent_size = 2

# JSON 文件
[*.json]
indent_style = space
indent_size = 2

# Markdown 文件
[*.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false

# YAML 文件
[*.{yml,yaml}]
indent_style = space
indent_size = 2

# Shell 脚本
[*.{sh,bash}]
indent_style = space
indent_size = 4
end_of_line = lf
